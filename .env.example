# Copy to .env in the repository root. Restart the backend after changes.
# Secrets stay on the backend; never use VITE_ variables for model credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional image-edit service overrides. Empty values reuse OPENAI_*.
IMAGE_EDIT_API_KEY=
IMAGE_EDIT_BASE_URL=
EVALUATION_MODEL=gpt-4.1-mini
IMAGE_EDIT_MODEL=gpt-image-2
MODEL_TIMEOUT_SECONDS=180
